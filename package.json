{
  "name": "vanguard-services",
  "version": "1.0.0",
  "description": "Vanguard Services platform - multi-department operations management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm --prefix client-frontend run build && npm --prefix admin-frontend run build",
    "test": "node --test --test-concurrency=1",
    "test:ci": "node --test --test-concurrency=1",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "render:build": "npm install && npm run prisma:generate && npm run build"
  },
  "keywords": [
    "vanguard",
    "express",
    "ejs",
    "prisma",
    "postgresql"
  ],
  "author": "Vanguard Services",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
