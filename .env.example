PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_a_strong_session_secret
JWT_SECRET=replace_with_a_strong_jwt_secret
JWT_EXPIRES_IN=8h
APP_NAME="Vanguard Services"
CORS_ORIGIN=https://vanguarservices.onrender.com
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_super_admin_password

# Cloudinary configuration (backend only; never expose API secret in the frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend build-time public values only (never secrets)
VITE_API_URL=/api
VITE_ADMIN_URL=/admin/login

# MbiyoPay sandbox / merchant configuration (backend only)
MBIYOPAY_API_KEY=
MBIYOPAY_BASE_URL=
MBIYOPAY_WEBHOOK_SECRET=
MBIYOPAY_MERCHANT_ID=
MBIYOPAY_CALLBACK_URL=
