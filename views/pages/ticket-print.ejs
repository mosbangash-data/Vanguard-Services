<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Billet <%= ticket.ticketCode %> — Vanguard Coach</title>
    <link rel="stylesheet" href="/css/ticket-print.css" />
  </head>
  <body class="ticket-body" data-ticket-format="<%= printFormat %>">
    <nav class="ticket-print-controls" aria-label="Options d’impression">
      <span>Format :</span>
      <a href="?format=58mm">58 mm</a><a href="?format=80mm">80 mm</a><a href="?format=110mm">110 mm</a><a href="?format=a4">A4</a>
      <button type="button" id="ticket-print-button">Imprimer</button>
      <small>Bluetooth et imprimantes intégrées passent par le service d’impression du terminal.</small>
    </nav>
    <main class="ticket-page">
      <article class="ticket-printable ticket--<%= printFormat %>" aria-label="Billet de voyage Vanguard Coach">
        <header class="ticket-brand">
          <img src="/assets/transport/logo.jpeg" alt="Logo Vanguard Services" />
          <div><strong>VANGUARD SERVICES</strong><span>VANGUARD COACH</span></div>
        </header>

        <section class="ticket-route" aria-label="Trajet">
          <strong><%= ticket.departureCity %></strong><span aria-hidden="true">→</span><strong><%= ticket.arrivalCity %></strong>
        </section>
        <div class="ticket-date"><%= new Date(ticket.departureAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %><span><%= ticket.departureTime %></span></div>

        <section class="ticket-passenger">
          <span class="ticket-label">Passager</span>
          <strong><%= ticket.customerName %></strong>
          <% if (ticket.customerPhone) { %><span><%= ticket.customerPhone %></span><% } %>
        </section>

        <div class="ticket-seat"><span>Siège</span><strong><%= ticket.seatNumber %></strong></div>
        <div class="ticket-qr" role="img" aria-label="QR code sécurisé du billet"><%- ticket.qrSvg %></div>

        <div class="ticket-code-row ticket-code-row--ticket"><span>Billet</span><strong><%= ticket.ticketCode %></strong></div>
        <div class="ticket-payment"><span class="ticket-payment__dot"></span><%= ticket.status === 'USED' ? 'UTILISÉ' : ticket.status === 'CANCELLED' ? 'ANNULÉ' : 'PAYÉ / VALIDE' %></div>
        <footer>Présentez ce billet à l’embarquement.</footer>
      </article>
    </main>
    <script src="/js/ticket-print.js" defer></script>
  </body>
</html>
