generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPER_ADMIN
  SERVICE_ADMIN
  MANAGER
  AGENT
  ENGINEER
  CONSTRUCTION
  SALES_AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DepartmentType {
  VANGUARD_COACH
  CONSTRUCTION
  AUTO_SALES
}

enum ContactSenderType {
  CUSTOMER
  INTERNAL_USER
}

enum ContactChannel {
  WHATSAPP
  PHONE
  EMAIL
  VISIT
  OTHER
}

enum CustomerRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WAITING_CLIENT
  CONVERTED
  RESOLVED
  CLOSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PHONE
  SMS
  WHATSAPP
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  COMPLETED
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum TicketScanResult {
  SUCCESS
  ALREADY_USED
  INVALID
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ConditionType {
  HOURS_BEFORE_DEPARTURE
  FIXED_WINDOW
}

enum PenaltyType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ParcelStatus {
  REGISTERED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CLIENT
  CLOSED
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_MAINTENANCE
}

enum VehicleReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum VehicleInquiryType {
  INFORMATION
  PRICE_REQUEST
  CONTACT
}

model Language {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userPreferences                  UserPreference[]
  departmentTranslations           DepartmentTranslation[]
  projectTranslations              ProjectTranslation[]
  projectUpdateTranslations        ProjectUpdateTranslation[]
  vehicleTranslations              VehicleTranslation[]
  notificationTemplateTranslations NotificationTemplateTranslation[]
  websiteSettings                  WebsiteSetting[]
}

model UserPreference {
  id         String   @id @default(cuid())
  userId     String
  languageId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Department {
  id          String         @id @default(cuid())
  type        DepartmentType @unique
  name        String
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users                      User[]
  settings                   ServiceSettings?
  translations               DepartmentTranslation[]
  buses                      Bus[]
  routes                     Route[]
  agencies                   Agency[]
  drivers                    Driver[]
  projects                   Project[]
  vehicles                   Vehicle[]
  customerRequests           CustomerRequest[]
  quoteRequests              QuoteRequest[]
  paymentMethods             PaymentMethodConfig[]
  cancellationPolicies       CancellationPolicy[]
  vehicleReservationPolicies VehicleReservationPolicy[]
}

model Agency {
  id           String   @id @default(cuid())
  departmentId String
  code         String   @unique
  name         String
  address      String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model Driver {
  id           String   @id @default(cuid())
  departmentId String
  firstName    String
  lastName     String
  licenseNumber String  @unique
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model DepartmentTranslation {
  id           String   @id @default(cuid())
  departmentId String
  languageId   String
  title        String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([departmentId, languageId])
}

model ServiceSettings {
  id                 String   @id @default(cuid())
  departmentId       String   @unique
  reservationEnabled Boolean  @default(true)
  paymentConfig      Json?
  currency           String   @default("USD")
  rules              Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model PaymentMethodConfig {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String
  isActive     Boolean  @default(true)
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, code])
}

model WebsiteSetting {
  id                String   @id @default(cuid())
  logoUrl           String?
  companyName       String?
  address           String?
  phone             String?
  email             String?
  whatsapp          String?
  facebook          String?
  twitter           String?
  instagram         String?
  defaultLanguageId String?
  generalInfo       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  defaultLanguage Language? @relation(fields: [defaultLanguageId], references: [id], onDelete: SetNull)
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  firstLogin   Boolean    @default(true)
  roleId       String
  departmentId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  role                            Role                             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department                      Department?                      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  preferences                     UserPreference[]
  uploadedMedia                   Media[]                          @relation("UploadedMedia")
  assignedRequests                CustomerRequest[]                @relation("AssignedRequests")
  sentContacts                    Contact[]                        @relation("ContactSender")
  notifications                   Notification[]                   @relation("NotificationReceiver")
  validatedPayments               Payment[]                        @relation("ValidatedPayments")
  issuedTickets                   Ticket[]                         @relation("IssuedTickets")
  scannedTickets                  TicketScan[]                     @relation("ScannedBy")
  assignedVehicleInquiries        VehicleInquiry[]                 @relation("AssignedVehicleInquiries")
  createdVehicleInquiries         VehicleInquiry[]                 @relation("CreatedVehicleInquiries")
  createdReservations             Reservation[]                    @relation("CreatedReservations")
  reservationCancellations        ReservationCancellation[]        @relation("CancelledReservations")
  vehicleReservationCancellations VehicleReservationCancellation[] @relation("CancelledVehicleReservations")
  quoteRequests                   QuoteRequest[]
  vehicleReservations             VehicleReservation[]
  projectAssignments              ProjectAssignment[]
}

model Media {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  entityType   String
  entityId     String
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy     User             @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: Restrict)
  vehicleMedia   VehicleMedia[]
  projectGallery ProjectGallery[]
}

model CustomerRequest {
  id               String                @id @default(cuid())
  departmentId     String?
  sourceModule     String
  subject          String
  customerName     String
  customerEmail    String?
  customerPhone    String?
  message          String
  status           CustomerRequestStatus @default(NEW)
  assignedToUserId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("AssignedRequests", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  contacts   Contact[]
}

model Contact {
  id                String            @id @default(cuid())
  customerRequestId String
  senderType        ContactSenderType
  senderUserId      String?
  senderName        String?
  senderEmail       String?
  senderPhone       String?
  channel           ContactChannel
  message           String
  createdAt         DateTime          @default(now())

  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Cascade)
  senderUser      User?           @relation("ContactSender", fields: [senderUserId], references: [id], onDelete: SetNull)
}

model NotificationTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  defaultTitle   String
  defaultMessage String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  translations  NotificationTemplateTranslation[]
  notifications Notification[]
}

model NotificationTemplateTranslation {
  id         String   @id @default(cuid())
  templateId String
  languageId String
  title      String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  language Language             @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([templateId, languageId])
}

model Notification {
  id             String               @id @default(cuid())
  userId         String?
  templateId     String?
  recipientEmail String?
  recipientPhone String?
  channel        NotificationChannel?
  title          String
  message        String
  type           NotificationType     @default(INFO)
  isRead         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user     User?                 @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
}

model Bus {
  id           String    @id @default(cuid())
  departmentId String
  plateNumber  String    @unique
  brand        String
  model        String
  seats        Int
  status       BusStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
}

model Route {
  id            String      @id @default(cuid())
  departmentId  String
  code          String      @unique
  departureCity String
  arrivalCity   String
  distanceKm    Int?
  durationHours Int?
  description   String?
  status        RouteStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
}

model Schedule {
  id            String         @id @default(cuid())
  departmentId  String
  routeId       String
  busId         String
  departureTime String
  returnTime    String?
  availableDays String[]
  price         Decimal        @db.Decimal(10, 2)
  status        ScheduleStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  route Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bus   Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  trips Trip[]
}

model Trip {
  id          String     @id @default(cuid())
  scheduleId  String
  departureAt DateTime
  arrivalAt   DateTime
  status      TripStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

model Reservation {
  id              String            @id @default(cuid())
  reservationCode String            @unique
  tripId          String
  customerName    String
  customerPhone   String
  customerEmail   String?
  seatNumber      String
  totalAmount     Decimal           @db.Decimal(10, 2)
  status          ReservationStatus @default(PENDING)
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  trip          Trip                      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy     User?                     @relation("CreatedReservations", fields: [createdByUserId], references: [id], onDelete: SetNull)
  payments      Payment[]
  tickets       Ticket[]
  cancellations ReservationCancellation[]

  @@unique([tripId, seatNumber])
  @@index([reservationCode])
  @@index([customerPhone])
  @@index([status])
  @@index([tripId])
}

model CancellationPolicy {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  rules      CancellationRule[]
}

model CancellationRule {
  id                          String        @id @default(cuid())
  policyId                    String
  conditionType               ConditionType @default(HOURS_BEFORE_DEPARTURE)
  minimumHoursBeforeDeparture Int?
  maximumHoursBeforeDeparture Int?
  penaltyType                 PenaltyType   @default(PERCENTAGE)
  penaltyValue                Decimal?      @db.Decimal(10, 2)
  refundPercentage            Decimal?      @db.Decimal(5, 2)
  description                 String?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  policy CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

model ReservationCancellation {
  id                String             @id @default(cuid())
  reservationId     String
  cancelledByUserId String?
  reason            String?
  penaltyAmount     Decimal?           @db.Decimal(10, 2)
  refundAmount      Decimal?           @db.Decimal(10, 2)
  status            CancellationStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  cancelledBy User?       @relation("CancelledReservations", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
}

model Payment {
  id                   String        @id @default(cuid())
  reservationId        String?
  vehicleReservationId String?
  parcelId             String?
  amount               Decimal       @db.Decimal(10, 2)
  method               String
  status               PaymentStatus @default(PENDING)
  reference            String?
  comment              String?
  validatedById        String?
  validatedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reservation        Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  vehicleReservation VehicleReservation? @relation(fields: [vehicleReservationId], references: [id], onDelete: SetNull)
  parcel             Parcel?             @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  validatedBy        User?               @relation("ValidatedPayments", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([reference])
  @@index([status])
  @@index([vehicleReservationId])
}

model Ticket {
  id             String       @id @default(cuid())
  ticketCode     String       @unique
  reservationId  String
  qrCode         String       @unique
  serialNumber   String       @unique
  status         TicketStatus @default(VALID)
  issuedByUserId String?
  issuedAt       DateTime     @default(now())
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  issuedBy    User?        @relation("IssuedTickets", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  scans       TicketScan[]

  @@index([ticketCode])
  @@unique([reservationId])
  @@index([qrCode])
  @@index([serialNumber])
}

model TicketScan {
  id              String           @id @default(cuid())
  ticketId        String
  scannedByUserId String
  scannedAt       DateTime         @default(now())
  result          TicketScanResult
  notes           String?
  createdAt       DateTime         @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scannedBy User   @relation("ScannedBy", fields: [scannedByUserId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  details   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parcel {
  id              String       @id @default(cuid())
  trackingCode    String       @unique
  senderName      String
  senderPhone     String
  recipientName   String
  recipientPhone  String
  originCity      String
  destinationCity String
  weightKg        Decimal      @db.Decimal(8, 2)
  volumeM3        Decimal      @db.Decimal(8, 2)
  amount          Decimal      @db.Decimal(10, 2)
  status          ParcelStatus @default(REGISTERED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payments Payment[]

  @@index([trackingCode])
  @@index([status])
}

model Project {
  id                String        @id @default(cuid())
  departmentId      String
  title             String
  slug              String?       @unique
  location          String?
  description       String?
  budget            Decimal?      @db.Decimal(12, 2)
  status            ProjectStatus @default(DRAFT)
  publicationStatus String        @default("DRAFT")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  translations ProjectTranslation[]
  gallery      ProjectGallery[]
  updates      ProjectUpdate[]
  assignments  ProjectAssignment[]
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model ProjectTranslation {
  id          String   @id @default(cuid())
  projectId   String
  languageId  String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([projectId, languageId])
}

model ProjectGallery {
  id        String   @id @default(cuid())
  projectId String
  mediaId   String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectUpdateTranslation[]
}

model ProjectUpdateTranslation {
  id          String   @id @default(cuid())
  updateId    String
  languageId  String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  update   ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  language Language      @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([updateId, languageId])
}

model QuoteRequest {
  id               String             @id @default(cuid())
  departmentId     String?
  customerName     String
  customerEmail    String?
  customerPhone    String?
  projectType      String?
  description      String
  budgetRange      String?
  status           QuoteRequestStatus @default(NEW)
  assignedToUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
}

model Vehicle {
  id           String        @id @default(cuid())
  departmentId String
  brand        String
  model        String
  year         Int
  mileage      Int?
  fuelType     String?
  transmission String?
  color        String?
  price        Decimal       @db.Decimal(12, 2)
  currency     String        @default("USD")
  status       VehicleStatus @default(AVAILABLE)
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  translations VehicleTranslation[]
  media        VehicleMedia[]
  inquiries    VehicleInquiry[]
  reservations VehicleReservation[]
}

model VehicleTranslation {
  id          String   @id @default(cuid())
  vehicleId   String
  languageId  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, languageId])
}

model VehicleMedia {
  id        String   @id @default(cuid())
  vehicleId String
  mediaId   String
  caption   String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleReservationPolicy {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model VehicleInquiry {
  id                String                @id @default(cuid())
  vehicleId         String
  customerName      String
  customerEmail     String?
  customerPhone     String?
  inquiryType       VehicleInquiryType
  contactPreference String?
  message           String
  internalNotes     String?
  status            CustomerRequestStatus @default(NEW)
  assignedToUserId  String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedTo User?   @relation("AssignedVehicleInquiries", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreatedVehicleInquiries", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([assignedToUserId])
  @@index([createdByUserId])
  @@index([status])
}

model VehicleReservation {
  id                String                   @id @default(cuid())
  reservationCode   String                   @unique
  vehicleId         String
  customerName      String
  customerPhone     String
  customerEmail     String?
  status            VehicleReservationStatus @default(PENDING)
  reservationAmount Decimal                  @db.Decimal(12, 2)
  depositAmount     Decimal?                 @db.Decimal(12, 2)
  paymentStatus     PaymentStatus            @default(PENDING)
  reservationDate   DateTime
  expirationDate    DateTime?
  createdByUserId   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  vehicle       Vehicle                          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy     User?                            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  payments      Payment[]
  cancellations VehicleReservationCancellation[]

  @@index([vehicleId])
  @@index([reservationCode])
  @@index([status])
}

model VehicleReservationCancellation {
  id                   String             @id @default(cuid())
  vehicleReservationId String
  cancelledByUserId    String?
  reason               String?
  penaltyAmount        Decimal?           @db.Decimal(10, 2)
  refundAmount         Decimal?           @db.Decimal(10, 2)
  status               CancellationStatus @default(PENDING)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  vehicleReservation VehicleReservation @relation(fields: [vehicleReservationId], references: [id], onDelete: Cascade)
  cancelledBy        User?              @relation("CancelledVehicleReservations", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
}
